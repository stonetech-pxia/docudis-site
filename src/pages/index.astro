    <rect x="19" y="14" width="26" height="36" rx="3.5" fill="#FFFCF8"/>
    <rect x="23.5" y="20" width="17" height="2.6" rx="1.3" fill="#E3D3C2"/>
    <rect x="23.5" y="26.5" width="4.5" height="2.6" rx="1.3" fill="#E3D3C2"/>
    <rect x="29.5" y="25.6" width="11" height="4.4" rx="1.2" fill="#2A2420"/>
    <rect x="23.5" y="33" width="17" height="2.6" rx="1.3" fill="#E3D3C2"/>
    <rect x="23.5" y="39.5" width="11" height="2.6" rx="1.3" fill="#E3D3C2"/>
  </symbol>
  <symbol id="i-github" viewBox="0 0 24 24"><path fill="currentColor" d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.52 2.34 1.08 2.91.83.09-.65.35-1.08.63-1.33-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.02a9.56 9.56 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.38.2 2.4.1 2.65.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85v2.75c0 .27.18.58.69.48A10 10 0 0 0 12 2Z"/></symbol>
