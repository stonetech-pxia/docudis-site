---
import Landing from '../layouts/Landing.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Landing
	title="Docudis: remove personal details before you ask AI"
	description="Docudis finds names, emails, phone numbers, IBANs and addresses in your documents and replaces them with labels, on your phone, before you send them to an AI."
>
<svg width="0" height="0" style="position:absolute" aria-hidden="true">
