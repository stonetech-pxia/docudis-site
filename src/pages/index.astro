<script>
(() => {
  // Demo: switch between anonymized and original text
  const doc = document.getElementById('doc');
  const ents = doc.querySelectorAll('.ent');
  const masked = document.getElementById('view-masked');
  const original = document.getElementById('view-original');
  const status = document.getElementById('status-text');
  function render(showMasked) {
    ents.forEach(e => { e.textContent = showMasked ? e.dataset.p : e.dataset.o; });
    doc.classList.toggle('masked', showMasked);
    masked.setAttribute('aria-pressed', String(showMasked));
    original.setAttribute('aria-pressed', String(!showMasked));
    status.textContent = showMasked ? '7 items replaced.' : '7 items found. Only you see this view.';
  }
  masked.addEventListener('click', () => render(true));
  original.addEventListener('click', () => render(false));
  render(true);

  // Code tabs
  const tabs = document.querySelectorAll('.term-tabs [role="tab"]');
  tabs.forEach(tab => tab.addEventListener('click', () => {
    tabs.forEach(t => {
      const on = t === tab;
      t.setAttribute('aria-selected', String(on));
      document.getElementById(t.getAttribute('aria-controls')).hidden = !on;
    });
  }));

  // Copy the visible code sample
  const copyBtn = document.getElementById('copy-btn');
  copyBtn.addEventListener('click', () => {
    const pane = document.querySelector('.term pre:not([hidden])');
    const done = () => { copyBtn.textContent = 'Copied'; setTimeout(() => copyBtn.textContent = 'Copy', 1500); };
    navigator.clipboard.writeText(pane.innerText).then(done, () => {
      const r = document.createRange(); r.selectNodeContents(pane);
      const s = getSelection(); s.removeAllRanges(); s.addRange(r);
    });
  });

  // Theme toggle: flips the current effective theme and remembers it for the docs too
  const root = document.documentElement;
  document.getElementById('theme-toggle').addEventListener('click', () => {
    const dark = root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
    const next = dark ? 'light' : 'dark';
    root.dataset.theme = next;
    try { localStorage.setItem('starlight-theme', next); } catch {}
  });
})();
</script>
